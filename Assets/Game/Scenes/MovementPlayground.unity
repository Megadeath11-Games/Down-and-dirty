--- !u!114 &876992554
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 876992551}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d30f48a7bc53bcc4a8e7f40e000b3c71, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::FPSBase.Mining.VehicleDealer
  listings:
  - name: Mini Excavator 1.5t
    description: 'Another 1.5 t mini excavator: 80 L bucket and a backfill blade.'
    price: 18000
    prefab: {fileID: 3434234311189695772, guid: 70cee29e25f89e442a6de40a1af65ad7, type: 3}
    heavy: 0
    category: Starter machines
  - name: GMT400 3/4-Ton 4x4 Pickup
    description: "Another '90s starter pickup: dump box (1.5 m\xB3, or 1.0 m\xB3
      with the tank in), 420 L tidy tank to refuel your machines in the field (take
      it out for a bigger box), pintle hook for the fuel bowser and the tilt trailer,
      and a gooseneck ball you can fit in the bed for the gooseneck trailer. 2WD
      / 4-high / 4-low. 130 L tank."
    price: 11500
    prefab: {fileID: 4553176907247991762, guid: 7ca86df222f943a47a2bf28b23a4bce7, type: 3}
    heavy: 0
    category: Starter machines
  - name: Compact Excavator 5 t
    description: '180 L bucket and a front backfill blade (blade up/down keys): push
      dirt forward, or drag it back in reverse. 75 L tank.'
    price: 48000
    prefab: {fileID: 8832250662509945397, guid: a232801e1f3e56f46bb57c5adec34849, type: 3}
    heavy: 0
    category: Excavators
  - name: Excavator 20 t
    description: "1.35 m\xB3 bucket, twin boom rams and a dozer blade for backfilling.
      The workhorse: reaches bedrock easily. 340 L tank. Machines of 20 t and up
      are delivered to the heavy-equipment yard east of the wash plant."
    price: 165000
    prefab: {fileID: 951353122500406099, guid: 243bd330839a3dc478b8a6f39bd1662b, type: 3}
    heavy: 1
    category: Excavators
  - name: Heavy Excavator 50 t
    description: "3.6 m\xB3 bucket, catwalks and handrails. Fills a haul truck in
      four passes. 700 L tank."
    price: 420000
    prefab: {fileID: 5760458433353989776, guid: ae7c96a0dd0026146ac8c2c51a8c3622, type: 3}
    heavy: 1
    category: Excavators
  - name: Mass Excavator 70 t
    description: "5.4 m\xB3 mining bucket with wear shrouds. Late-game production
      machine. 950 L tank."
    price: 680000
    prefab: {fileID: 2537348240292158208, guid: 8473137cc7030f74ba716db64fc39276, type: 3}
    heavy: 1
    category: Excavators
  - name: Mining Excavator 90 t
    description: "7.8 m\xB3 bucket - the biggest digger on the claim. Slow, hungry,
      unstoppable. 1,300 L tank."
    price: 950000
    prefab: {fileID: 8166799334921525004, guid: dd1d4b248afb91a4281d3c362f9a7a7c, type: 3}
    heavy: 1
    category: Excavators
  - name: Bulldozer (small crawler)
    description: 2.5 m blade. Cuts and pushes dirt, strips overburden fast, builds
      piles. 200 L tank.
    price: 85000
    prefab: {fileID: 1559387274550973137, guid: 380f14b1ddb56ba4c83917a7c3a23f1b, type: 3}
    heavy: 0
    category: Dozers & loaders
  - name: Medium Dozer 22 t
    description: "3.45 m semi-U blade on push arms (5.6 m\xB3) and a 3-shank ripper:
      rip hard ground, then push it. 400 L tank."
    price: 260000
    prefab: {fileID: 5140478856189347060, guid: 296ddd816a65b8b40a5a18ef8c81fcb3, type: 3}
    heavy: 1
    category: Dozers & loaders
  - name: Mining Dozer 66.5 t
    description: "4.95 m U blade (18.5 m\xB3) and a single giant ripper shank. Moves
      a hillside. 1,100 L tank."
    price: 820000
    prefab: {fileID: 4371220247041997108, guid: e52dc3b877cc20c44a7ffae2c42de0de, type: 3}
    heavy: 1
    category: Dozers & loaders
  - name: Wheel Loader (compact)
    description: "0.9 m\xB3 bucket. Scoops piles, carries dirt and loads trucks or
      the hopper. 150 L tank."
    price: 65000
    prefab: {fileID: 5765773583000396452, guid: 30c98f97075f2e04c97a5d94e3122996, type: 3}
    heavy: 0
    category: Dozers & loaders
  - name: Stand-On Mini Track Loader 1 t
    description: Ride-on-the-back mini track loader with a 160 L bucket. Tiny, nimble,
      fits anywhere. 30 L tank.
    price: 32000
    prefab: {fileID: 828767819276762358, guid: 4f241120c8ebfb74db0610e52568dce4, type: 3}
    heavy: 0
    category: Skid steers & grader
  - name: Wheeled Skid Steer 3.6 t
    description: "0.48 m\xB3 bucket, skid steering: spins on the spot. Quick on hard
      ground. 95 L tank."
    price: 62000
    prefab: {fileID: 3664089029339192989, guid: 14672f22a9bc4e540bf282d01ad092c4, type: 3}
    heavy: 0
    category: Skid steers & grader
  - name: Compact Track Loader 5.2 t
    description: "0.78 m\xB3 bucket on rubber tracks: pushes and carries in soft
      dirt. 105 L tank."
    price: 89000
    prefab: {fileID: 5965839051729476511, guid: 35bcb41664f135c40bee91df91ee2a58, type: 3}
    heavy: 0
    category: Skid steers & grader
  - name: Motor Grader 19.5 t
    description: '4.27 m moldboard on a drawbar and circle: lift each end, turn,
      side-shift and pitch it, plus articulation, wheel lean and a rear ripper. Cuts
      and spreads dirt and gravel into flat roads. 416 L tank. Machines of 20 t and
      up are delivered to the heavy-equipment yard east of the wash plant.'
    price: 340000
    prefab: {fileID: 6700092168981226062, guid: 756b31e62d7bb2f488348c2a36f10eca, type: 3}
    heavy: 1
    category: Skid steers & grader
  - name: Single-Axle Dump Truck
    description: "6 m\xB3 dump box (4x the pickup). 250 L tank."
    price: 58000
    prefab: {fileID: 7106911899495332819, guid: 7c71d698f0b39f542ae9977c0f306a9f, type: 3}
    heavy: 0
    category: Trucks
  - name: Haul Truck 25t
    description: "14 m\xB3 haul truck for big operations. Slow but moves a mountain.
      400 L tank."
    price: 220000
    prefab: {fileID: 63133242585180246, guid: 6248bd85f95302a4ba4a5a2c8998a199, type: 3}
    heavy: 0
    category: Trucks
  - name: Field Fuel Bowser 3,500 L
    description: Tandem-axle diesel trailer with a pump, meter and hose reel. Tow
      it with a pickup's pintle hook, fill it at the fuel pump (look at it, scroll
      to Refuel), park it by your machines to fuel them. Comes with 1,200 L.
    price: 18000
    prefab: {fileID: 6121185777815908522, guid: 682c515b8bb818a489aab91cbdcb3a9b, type: 3}
    heavy: 0
    category: Transport & fuel
  - name: Tilt-Deck Equipment Trailer 7 t
    description: 'Bumper-pull tandem trailer (5.4 m oak deck, 4.8 t payload) for
      the pickup''s hitch. Hydraulic tilt deck: tilt it down from its menu, drive
      on over the back, level it and the machine is chained down. Carries the skid
      steers and the 5 t excavator.'
    price: 9500
    prefab: {fileID: 7557651533125363870, guid: 85778f525e545334ca4ad0f29c921d93, type: 3}
    heavy: 0
    category: Transport & fuel
  - name: Gooseneck Equipment Trailer 10 t
    description: 'Tandem-dual gooseneck trailer (6.7 m deck, 6.8 t payload). Fit
      the gooseneck ball in the pickup''s bed and back in under the coupler. Folding
      ramps at the back: lower them, drive on, park and it''s chained down. Carries
      the skid steers and the 5 t excavator.'
    price: 14500
    prefab: {fileID: 1034860106677027124, guid: 1c108e6b9e8ebf4479ee9b9a3e84d40a, type: 3}
    heavy: 0
    category: Transport & fuel
  - name: Semi Truck 25 t + RGN Lowboy
    description: Tandem-drive tractor with a condo sleeper and a 25 t removable-gooseneck
      lowboy (6.4 m deck). Detach the neck to drop the deck, drive a machine on over
      the front, hook the neck back on and haul it. 600 L tank.
    price: 145000
    prefab: {fileID: 7133391834366809812, guid: 63650a49fda2fa548aadb793b32c67f0, type: 3}
    heavy: 1
    category: Transport & fuel
  - name: Semi Truck 55 t + RGN Lowboy
    description: Tri-drive heavy hauler with a 55 t RGN lowboy (7.4 m deck, 3 axles).
      Carries the 20 t and 50 t excavators and the 22 t dozer. 900 L tank.
    price: 230000
    prefab: {fileID: 3496652396463475256, guid: 04ce4a4e7331d524ba2dd2cf97d6e101, type: 3}
    heavy: 1
    category: Transport & fuel
  - name: Semi Truck 95 t + RGN Lowboy
    description: Quad-drive mining hauler, 95 t RGN lowboy with a 5.2 m wide deck
      and a two-axle booster. Moves the 70-90 t excavators and the mining dozer.
